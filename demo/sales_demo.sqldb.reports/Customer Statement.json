{
  "format": 1,
  "name": "Customer Statement",
  "title": "Customer Statement",
  "description": "Everything one customer ordered: details, a chart of their spending and every order with its lines.",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 40,
      "right": 36,
      "bottom": 40,
      "left": 36
    }
  },
  "parameters": [
    {
      "name": "customer",
      "label": "Customer",
      "type": "integer",
      "default": 62,
      "required": true,
      "optionsSql": "SELECT id, name FROM customers ORDER BY name"
    }
  ],
  "datasets": [
    {
      "name": "info",
      "sql": "SELECT c.name, c.city, c.country, c.region, c.segment, c.industry, c.customer_since, c.contact, c.credit_limit, e.name AS rep FROM customers c LEFT JOIN employees e ON e.id = c.rep_id WHERE c.id = :customer"
    },
    {
      "name": "kpi",
      "sql": "SELECT count(DISTINCT order_id) AS orders, round(sum(revenue)) AS revenue, round(sum(revenue) / count(DISTINCT order_id)) AS avg_order, min(order_date) AS first_order, max(order_date) AS last_order FROM sales WHERE customer_id = :customer"
    },
    {
      "name": "lines",
      "sql": "SELECT o.id AS order_id, o.order_date, o.status, o.channel, p.name AS product, i.quantity, i.unit_price, round(i.quantity * i.unit_price * (1 - o.discount), 2) AS amount FROM orders o JOIN order_items i ON i.order_id = o.id JOIN products p ON p.id = i.product_id WHERE o.customer_id = :customer ORDER BY o.order_date, o.id, p.name"
    },
    {
      "name": "monthly",
      "sql": "SELECT month, round(sum(revenue)) AS revenue FROM sales WHERE customer_id = :customer GROUP BY month ORDER BY month"
    }
  ],
  "header": [
    {
      "type": "text",
      "text": "{{ReportName}}",
      "style": {
        "face": "bold",
        "size": 8,
        "color": "#6b7280"
      }
    },
    {
      "type": "rule"
    }
  ],
  "footer": [
    {
      "type": "rule"
    },
    {
      "type": "text",
      "text": "Aurelia Systems · fictional demo data   ·   Page {{PageNumber}} of {{PageCount}}",
      "style": {
        "size": 8,
        "color": "#6b7280",
        "align": "right"
      }
    }
  ],
  "body": [
    {
      "type": "columns",
      "gap": 8,
      "columns": [
        {
          "width": 1,
          "items": [
            {
              "type": "image",
              "src": "data:image/svg+xml;base64,",
              "width": 34
            }
          ]
        },
        {
          "width": 14,
          "items": [
            {
              "type": "text",
              "rich": true,
              "text": "[size=20][b][color=#43a047]Customer Statement[/color][/b][/size]\n[size=9][color=#6b7280]{{First(name)}}[/color][/size]",
              "dataset": "info"
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "text",
      "rich": true,
      "text": "[size=11][b]{{First(city)}}, {{First(country)}}[/b]  ({{First(region)}})[/size]\n[size=9][color=#6b7280]{{First(segment)}} customer in {{First(industry)}} since {{First(customer_since)}}   ·   contact {{First(contact)}}   ·   account manager {{First(rep)}}   ·   credit limit {{Format(First(credit_limit), \"$#,##0\")}}[/color][/size]",
      "dataset": "info"
    },
    {
      "type": "spacer",
      "height": 6
    },
    {
      "type": "columns",
      "gap": 10,
      "columns": [
        {
          "width": 1,
          "card": true,
          "accent": "#43a047",
          "items": [
            {
              "type": "text",
              "rich": true,
              "text": "[size=8][color=#6b7280]ORDERED[/color][/size]\n[size=16][b]{{Format(First(revenue), \"$#,##0\")}}[/b][/size]\n[size=8][color=#6b7280]cancelled orders excluded[/color][/size]",
              "dataset": "kpi"
            }
          ]
        },
        {
          "width": 1,
          "card": true,
          "accent": "#1976d2",
          "items": [
            {
              "type": "text",
              "rich": true,
              "text": "[size=8][color=#6b7280]ORDERS[/color][/size]\n[size=16][b]{{First(orders)}}[/b][/size]\n[size=8][color=#6b7280]average {{Format(First(avg_order), \"$#,##0\")}}[/color][/size]",
              "dataset": "kpi"
            }
          ]
        },
        {
          "width": 1,
          "card": true,
          "accent": "#fb8c00",
          "items": [
            {
              "type": "text",
              "rich": true,
              "text": "[size=8][color=#6b7280]FIRST ORDER[/color][/size]\n[size=16][b]{{First(first_order)}}[/b][/size]\n[size=8][color=#6b7280]on record[/color][/size]",
              "dataset": "kpi"
            }
          ]
        },
        {
          "width": 1,
          "card": true,
          "accent": "#8e24aa",
          "items": [
            {
              "type": "text",
              "rich": true,
              "text": "[size=8][color=#6b7280]LAST ORDER[/color][/size]\n[size=16][b]{{First(last_order)}}[/b][/size]\n[size=8][color=#6b7280]most recent[/color][/size]",
              "dataset": "kpi"
            }
          ]
        }
      ]
    },
    {
      "type": "spacer",
      "height": 8
    },
    {
      "type": "chart",
      "chart": "bar",
      "dataset": "monthly",
      "category": "month",
      "title": "Spending by month (cancelled orders excluded)",
      "height": 180,
      "labels": true,
      "format": "$#,##0",
      "series": [
        {
          "field": "revenue",
          "label": "Revenue",
          "color": "#43a047"
        }
      ]
    },
    {
      "type": "table",
      "dataset": "lines",
      "grandTotal": true,
      "groups": [
        {
          "field": "order_id",
          "header": "Order {{order_id}}   ·   {{First(order_date)}}   ·   {{First(status)}}   ·   {{First(channel)}}",
          "subtotals": true
        }
      ],
      "columns": [
        {
          "field": "product",
          "header": "Product",
          "width": 3.4
        },
        {
          "field": "quantity",
          "header": "Qty",
          "width": 0.6,
          "total": "sum",
          "format": "#,##0"
        },
        {
          "field": "unit_price",
          "header": "Unit price",
          "format": "#,##0.00",
          "width": 1.1
        },
        {
          "field": "amount",
          "header": "Amount",
          "format": "#,##0.00",
          "total": "sum",
          "width": 1.1
        }
      ]
    }
  ]
}
