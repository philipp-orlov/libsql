{
  "format": 1,
  "name": "Regional Review",
  "title": "Regional Review",
  "description": "A cover and one page per region: the Region Snapshot report, run once for every region as a sub-report.",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 40,
      "right": 36,
      "bottom": 40,
      "left": 36
    }
  },
  "parameters": [
    {
      "name": "year",
      "label": "Year",
      "type": "integer",
      "default": 2026,
      "required": true,
      "optionsSql": "SELECT DISTINCT year FROM sales ORDER BY 1 DESC"
    }
  ],
  "datasets": [
    {
      "name": "regions",
      "sql": "SELECT region, count(DISTINCT customer_id) AS customers, count(DISTINCT order_id) AS orders, round(sum(revenue)) AS revenue FROM sales WHERE year = :year GROUP BY region ORDER BY revenue DESC"
    }
  ],
  "header": [
    {
      "type": "text",
      "text": "{{ReportName}}",
      "style": {
        "face": "bold",
        "size": 8,
        "color": "#6b7280"
      }
    },
    {
      "type": "rule"
    }
  ],
  "footer": [
    {
      "type": "rule"
    },
    {
      "type": "text",
      "text": "Aurelia Systems · fictional demo data   ·   Page {{PageNumber}} of {{PageCount}}",
      "style": {
        "size": 8,
        "color": "#6b7280",
        "align": "right"
      }
    }
  ],
  "body": [
    {
      "type": "image",
      "src": "data:image/png;base64,",
      "fitWidth": true
    },
    {
      "type": "spacer",
      "height": 10
    },
    {
      "type": "text",
      "rich": true,
      "text": "[size=28][b][color=#0d47a1]Regional Review {{year}}[/color][/b][/size]\n[size=11][color=#6b7280]Aurelia Systems  ·  sales by region  ·  generated {{Format(Now, \"yyyy-MM-dd\")}}[/color][/size]"
    },
    {
      "type": "spacer",
      "height": 10
    },
    {
      "type": "text",
      "rich": true,
      "text": "This review covers [b]{{Count()}} regions[/b] and [b]{{Format(Sum(revenue), \"$#,##0\")}}[/b] of revenue from [b]{{Format(Sum(orders), \"#,##0\")}} orders[/b].\n- Each region has a page of its own: the [b]Region Snapshot[/b] report, run as a sub-report with that region and this year.\n- In the table below, a click on a region opens its snapshot on its own.\n- The same pages can be made for any report: a sub-report takes parameters from a row, or from the page it sits on.",
      "dataset": "regions",
      "style": {
        "size": 10
      }
    },
    {
      "type": "spacer",
      "height": 8
    },
    {
      "type": "table",
      "dataset": "regions",
      "zebra": true,
      "grandTotal": true,
      "columns": [
        {
          "field": "region",
          "header": "Region",
          "width": 2.5
        },
        {
          "field": "customers",
          "header": "Customers",
          "total": "sum"
        },
        {
          "field": "orders",
          "header": "Orders",
          "format": "#,##0",
          "total": "sum"
        },
        {
          "field": "revenue",
          "header": "Revenue",
          "format": "$#,##0",
          "total": "sum",
          "width": 1.4
        },
        {
          "expression": "revenue / Sum(revenue)",
          "header": "Share",
          "format": "0.0%"
        }
      ],
      "drill": {
        "report": "Region Snapshot",
        "params": {
          "region": "{{region}}",
          "year": "{{year}}"
        }
      }
    },
    {
      "type": "pageBreak"
    },
    {
      "type": "subreport",
      "report": "Region Snapshot",
      "dataset": "regions",
      "params": {
        "region": "{{region}}"
      },
      "pageBreak": true,
      "limit": 8
    }
  ]
}
