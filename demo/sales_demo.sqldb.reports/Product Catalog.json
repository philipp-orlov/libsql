{
  "format": 1,
  "name": "Product Catalog",
  "title": "Product Catalog",
  "description": "Every product category as a card with its picture, read from the database: the Category Card report, run once for each category as a sub-report.",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 40,
      "right": 36,
      "bottom": 40,
      "left": 36
    }
  },
  "parameters": [
    {
      "name": "year",
      "label": "Year",
      "type": "integer",
      "default": 2026,
      "required": true,
      "optionsSql": "SELECT DISTINCT year FROM sales ORDER BY 1 DESC"
    }
  ],
  "datasets": [
    {
      "name": "categories",
      "sql": "SELECT name AS category FROM categories ORDER BY name"
    },
    {
      "name": "company",
      "sql": "SELECT name, tagline, logo FROM company"
    }
  ],
  "header": [
    {
      "type": "text",
      "text": "{{ReportName}}",
      "style": {
        "face": "bold",
        "size": 8,
        "color": "#6b7280"
      }
    },
    {
      "type": "rule"
    }
  ],
  "footer": [
    {
      "type": "rule"
    },
    {
      "type": "text",
      "text": "Aurelia Systems · fictional demo data   ·   Page {{PageNumber}} of {{PageCount}}",
      "style": {
        "size": 8,
        "color": "#6b7280",
        "align": "right"
      }
    }
  ],
  "body": [
    {
      "type": "columns",
      "gap": 8,
      "columns": [
        {
          "width": 1,
          "items": [
            {
              "type": "image",
              "src": "data:image/svg+xml;base64,",
              "width": 34
            }
          ]
        },
        {
          "width": 14,
          "items": [
            {
              "type": "text",
              "rich": true,
              "text": "[size=20][b][color=#0d47a1]Product Catalog {{year}}[/color][/b][/size]\n[size=9][color=#6b7280]{{First(name)}}  ·  {{First(tagline)}}[/color][/size]",
              "dataset": "company"
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "text",
      "rich": true,
      "text": "[size=10]Six categories, each laid out by the same report. The [b]picture[/b] of a category is a column of the database, shown by an [u]image item[/u] that reads it; the [b]cards[/b] are columns with a border; the text is [color=#e15759]rich[/color].[/size]"
    },
    {
      "type": "spacer",
      "height": 8
    },
    {
      "type": "subreport",
      "report": "Category Card",
      "dataset": "categories",
      "params": {
        "category": "{{category}}"
      }
    }
  ]
}
