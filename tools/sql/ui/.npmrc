# The web-ui-kit packages are file: dependencies (../../../../web-ui-kit). Copy them in rather than link them: a linked package
# resolves @angular/* from its own folder, and two copies of Angular break the app. After rebuilding the kit (`npm run build` in
# web-ui-kit/angular), run `npm run kit`: npm does not copy a file: package again while its version is the same.
install-links=true
legacy-peer-deps=true
