# Smoke sqllogictest file shared by sqlite and today's libsql subset.

hash-threshold 1000

statement ok
CREATE TABLE staff (id INTEGER PRIMARY KEY, name TEXT, dept TEXT, pay INTEGER)

statement ok
INSERT INTO staff VALUES
 (1, 'ada',     'eng', 100),
 (2, 'grace',   'eng', 120),
 (3, 'edsger',  'ops',  90),
 (4, 'barbara', 'ops', 130),
 (5, 'alan',    NULL,  NULL)

statement ok
CREATE INDEX by_staff_pay ON staff(pay)

statement ok
CREATE TABLE site (dept TEXT PRIMARY KEY, city TEXT)

statement ok
INSERT INTO site VALUES ('eng', 'oslo'), ('ops', 'lima')

statement ok
CREATE TABLE nums (id INTEGER PRIMARY KEY, n INTEGER, r REAL, t TEXT, b BLOB)

statement ok
INSERT INTO nums VALUES (1, 1, 1.25, 'one', x'31'), (2, 2, 2.5, 'two', x'32'), (3, NULL, NULL, '', x'')

